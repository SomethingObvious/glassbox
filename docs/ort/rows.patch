+
+    var mine : array<vec4<output_element_t>, 8 * rows>;
+    for (var n = 0u; n < 8 * rows; n++) {
+      mine[n] = vec4<output_element_t>(tile_A[(n / 8) * 256 + idx * 8 + n % 8]);
+    }
+    for (var local_row_offset = 0u; local_row_offset < tile_size; local_row_offset += 4) {
+      let b_global = b_global_base + local_row_offset + idy;
+      let k_offset = kidx / 32 + idx;
+      if (b_global < uniforms.N && k_offset < uniforms.K_of_b) {
+        let block_idx = (kidx + idx * 32) / uniforms.block_size;
