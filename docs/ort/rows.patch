+    for (var r = 0u; r < rows; r++) {
+      for (var id = local_idx; id < 256; id += workgroup_size_x) {
+        let a_offset = kidx / 4 + id;
+        if (batch < uniforms.batch_count && a_offset < uniforms.K_of_a) {
+          tile_A[r * 256 + id] = a.getByOffset((batch * rows + r) * uniforms.K_of_a + a_offset);
+        } else {
+          tile_A[r * 256 + id] = input_a_value_t(0);
+        }
+      }
+    }
