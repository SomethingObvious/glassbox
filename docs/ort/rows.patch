+// The fused 4-bit gate and up projections for a few rows of A, with a workgroup that takes many
+// output columns. A workgroup reads A from its buffer once and keeps all of it, scaled by the
+// norm, in workgroup memory. Reads from buffers are what this kernel waits on, so the fewer of
+// them go to A, the less a further row costs.
+//
+// Layout: 128 threads. Thread `idx` (0..31) of each of the 4 groups `idy` takes weight word `idx`
+// of every k tile of 32 words, for output column `first + idy`, so the 32 threads of a group read
+// 32 neighbouring words. The columns of a workgroup go 4 at a time.
+//
+// Fixed by the caller: 4-bit weights, block size 32, A and the weights bound as vec4, and K a
+// multiple of 1024.
+
+#param rows
+#param tile_cols
+// K / 4, the length of a row of A in vec4.
+#param a_length
+// a_length / workgroup size, the vec4 of A each thread reads for a row.
+#param a_per_thread
+// K / 1024
+#param k_tiles
+#param has_norm_input
+#param has_skip_input
+#param has_skip_output
+#param has_gate_bias
+#param has_up_bias
+#param single_scale_weights
+// Mirrors MlpActivationKind in matmul_nbits_mlp.h: 0 = SiLU.
+#param activation_kind
+
+#use .getByOffset .setByOffset
+
+#if has_norm_input
+var<workgroup> sum_squared_shared : array<f32, workgroup_size_x>;
+var<workgroup> inv_std_shared : array<f32, rows>;
+#endif
+var<workgroup> tile_A : array<input_a_value_t, a_length * rows>;
+// The 32 partial sums of 4 columns for every row.
+var<workgroup> gate_partial : array<f32, 128 * rows>;
+var<workgroup> up_partial : array<f32, 128 * rows>;
+
+fn load_merged_input(input_offset: u32) -> input_a_value_t {
+#if has_skip_input
+    let skip_offset = input_offset % (uniforms.skip_size / 4);
+    return a.getByOffset(input_offset) + input_a_value_t(skip.getByOffset(skip_offset));
+#else
+    return a.getByOffset(input_offset);
+#endif
+}
+
+// The 8 weights of one word, in the order of K, times their block's scale.
+fn unpack_lower(word: u32, scale: f32) -> vec4<f32> {
+  let lower = vec4<f32>(unpack4xU8(word & 0x0F0F0F0Fu)) - vec4<f32>(8.0);
+  let upper = vec4<f32>(unpack4xU8((word >> 4) & 0x0F0F0F0Fu)) - vec4<f32>(8.0);
+  return vec4<f32>(lower[0], upper[0], lower[1], upper[1]) * scale;
+}
+
+fn unpack_upper(word: u32, scale: f32) -> vec4<f32> {
+  let lower = vec4<f32>(unpack4xU8(word & 0x0F0F0F0Fu)) - vec4<f32>(8.0);
+  let upper = vec4<f32>(unpack4xU8((word >> 4) & 0x0F0F0F0Fu)) - vec4<f32>(8.0);
+  return vec4<f32>(lower[2], upper[2], lower[3], upper[3]) * scale;
