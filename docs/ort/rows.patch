+// as vec4<u32>, and a workgroup of 128.
+
+#param rows
+#param tile_size
+
+#use .getByOffset .setByOffset
+
+var<workgroup> tile_A : array<input_a_value_t, 256 * rows>;
+var<workgroup> inter_results : array<array<output_element_t, 32>, tile_size * rows>;
+
+$MAIN {
+  let batch = workgroup_idx / uniforms.num_N_tile;
+  let b_global_base = (workgroup_idx % uniforms.num_N_tile) * tile_size;
+  let idx = local_idx % 32;
+  let idy = local_idx / 32;
