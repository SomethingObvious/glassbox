+const default_zero_point = vec4<q_output_element_t>(q_output_element_t(8));
+
+fn unpack_nibble_values(word: u32) -> vec4<q_output_element_t> {
+  let unpacked = unpack4xU8(word);
+  return vec4<q_output_element_t>(q_output_element_t(unpacked[0]),
+                                  q_output_element_t(unpacked[1]),
+                                  q_output_element_t(unpacked[2]),
+                                  q_output_element_t(unpacked[3]));
+}
